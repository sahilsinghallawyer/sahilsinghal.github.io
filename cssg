<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sahil Singhal — CFE · Fraud Lawyer · Intelligence Researcher</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,600&family=Jost:wght@300;400;500;600&family=Josefin+Sans:wght@300;400;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;font-size:18px;}

:root{
  --black:   #080a07;
  --dark:    #0e1210;
  --dark2:   #141a17;
  --dark3:   #1c2622;
  --gold:    #b8882a;
  --gold2:   #d4a840;
  --gold3:   #e8c870;
  --gold4:   #f2dfa0;
  --ivory:   #f8f4ed;
  --ivory2:  #ede7d9;
  --ivory3:  #e0d8c6;
  --ivory4:  #cfc6b0;
  --text:    #1a201d;
  --text2:   #3d4e47;
  --text3:   #7a8e85;
  --rule:    rgba(26,32,29,0.08);
  --grule:   rgba(248,244,237,0.1);
}

body{
  background:var(--ivory);
  color:var(--text);
  font-family:'Jost',sans-serif;
  font-weight:300;
  line-height:1.65;
  overflow-x:hidden;
}

/* ── CURSOR GLOW ── */
.cursor-glow{
  position:fixed;
  width:400px;height:400px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(184,136,42,0.08) 0%,transparent 70%);
  pointer-events:none;
  z-index:9999;
  transform:translate(-50%,-50%);
  transition:left 0.6s ease,top 0.6s ease;
  will-change:left,top;
}

/* ── NAV ── */
nav{
  position:fixed;top:0;left:0;right:0;
  z-index:200;
  height:66px;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 60px;
  transition:background 0.4s,border-color 0.4s;
}
nav.scrolled{
  background:rgba(8,10,7,0.92);
  backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(184,136,42,0.2);
}

.nav-logo{
  font-family:'Josefin Sans',sans-serif;
  font-size:13px;
  font-weight:600;
  letter-spacing:0.32em;
  text-transform:uppercase;
  color:var(--gold3);
  text-decoration:none;
}

.nav-links{display:flex;gap:38px;list-style:none;}
.nav-links a{
  font-family:'Josefin Sans',sans-serif;
  font-size:11px;
  letter-spacing:0.2em;
  text-transform:uppercase;
  color:rgba(248,244,237,0.5);
  text-decoration:none;
  transition:color 0.25s;
}
.nav-links a:hover{color:var(--gold3);}

/* ── HERO ── */
.hero{
  min-height:100vh;
  background:var(--black);
  position:relative;
  overflow:hidden;
  display:flex;align-items:center;
  padding:120px 0 80px;
}

.hero-bg-text{
  position:absolute;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
  font-family:'Cormorant',serif;
  font-size:clamp(140px,18vw,280px);
  font-weight:700;
  color:rgba(255,255,255,0.025);
  white-space:nowrap;
  letter-spacing:-0.04em;
  pointer-events:none;
  user-select:none;
  line-height:1;
}

.hero-lines{
  position:absolute;
  inset:0;
  background-image:
    repeating-linear-gradient(90deg,transparent,transparent 119px,rgba(184,136,42,0.04) 119px,rgba(184,136,42,0.04) 120px);
  pointer-events:none;
}

.hero-glow{
  position:absolute;
  top:-20%;left:-10%;
  width:60%;height:80%;
  background:radial-gradient(ellipse,rgba(184,136,42,0.07) 0%,transparent 65%);
  pointer-events:none;
}

.hero-inner{
  max-width:1160px;
  margin:0 auto;
  padding:0 60px;
  position:relative;z-index:1;
  display:grid;
  grid-template-columns:1.15fr 0.85fr;
  gap:80px;
  align-items:center;
}

.hero-eyebrow{
  display:flex;align-items:center;gap:14px;
  font-family:'Josefin Sans',sans-serif;
  font-size:11px;
  letter-spacing:0.35em;
  text-transform:uppercase;
  color:var(--gold2);
  margin-bottom:28px;
  opacity:0;animation:fadeUp 0.8s 0.2s forwards;
}
.hero-eyebrow span{width:40px;height:1px;background:var(--gold2);display:block;}

.hero-name{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(56px,6.5vw,92px);
  font-weight:300;
  color:var(--ivory);
  line-height:1.02;
  letter-spacing:-0.02em;
  margin-bottom:28px;
  opacity:0;animation:fadeUp 0.8s 0.35s forwards;
}
.hero-name strong{
  font-weight:600;
  display:block;
  background:linear-gradient(135deg,var(--gold3),var(--gold2));
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
}

.hero-tags{
  display:flex;flex-wrap:wrap;gap:8px;
  margin-bottom:34px;
  opacity:0;animation:fadeUp 0.8s 0.5s forwards;
}
.hero-tag{
  font-family:'Josefin Sans',sans-serif;
  font-size:10px;
  letter-spacing:0.18em;
  text-transform:uppercase;
  padding:7px 16px;
  border:1px solid rgba(184,136,42,0.35);
  color:rgba(248,244,237,0.6);
  background:rgba(184,136,42,0.06);
}

.hero-desc{
  font-size:17.5px;
  color:rgba(248,244,237,0.58);
  line-height:1.88;
  max-width:520px;
  margin-bottom:44px;
  font-weight:300;
  opacity:0;animation:fadeUp 0.8s 0.65s forwards;
}
.hero-desc strong{color:rgba(248,244,237,0.88);font-weight:400;}

.hero-ctas{
  display:flex;gap:14px;flex-wrap:wrap;
  opacity:0;animation:fadeUp 0.8s 0.8s forwards;
}

.btn-gold{
  display:inline-flex;align-items:center;gap:10px;
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  color:var(--black);
  font-family:'Josefin Sans',sans-serif;
  font-size:11px;font-weight:600;
  letter-spacing:0.22em;text-transform:uppercase;
  padding:16px 32px;
  text-decoration:none;
  transition:all 0.3s;
  border:none;cursor:pointer;
}
.btn-gold:hover{
  background:linear-gradient(135deg,var(--gold2),var(--gold3));
  transform:translateY(-2px);
  box-shadow:0 16px 40px rgba(184,136,42,0.28);
}

.btn-outline{
  display:inline-flex;align-items:center;gap:10px;
  background:transparent;
  color:rgba(248,244,237,0.65);
  font-family:'Josefin Sans',sans-serif;
  font-size:11px;font-weight:400;
  letter-spacing:0.22em;text-transform:uppercase;
  padding:16px 28px;
  text-decoration:none;
  border:1px solid rgba(248,244,237,0.15);
  transition:all 0.25s;
  cursor:pointer;
}
.btn-outline:hover{color:var(--ivory);border-color:rgba(248,244,237,0.35);}

/* RIGHT — CREDENTIAL PANEL */
.cred-panel{
  opacity:0;animation:fadeLeft 0.9s 0.5s forwards;
}
.cred-card{
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(184,136,42,0.18);
  padding:40px;
  position:relative;
}
.cred-card::before{
  content:'';
  position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--gold2),transparent);
}
.cred-card::after{
  content:'';
  position:absolute;bottom:0;right:0;width:120px;height:120px;
  background:radial-gradient(circle,rgba(184,136,42,0.08) 0%,transparent 70%);
  pointer-events:none;
}

.cred-header{
  font-family:'Josefin Sans',sans-serif;
  font-size:9px;
  letter-spacing:0.35em;
  text-transform:uppercase;
  color:var(--gold2);
  margin-bottom:26px;
  display:flex;align-items:center;gap:10px;
}
.cred-header::before{content:'';width:16px;height:1px;background:var(--gold2);}

.cred-row{
  display:flex;gap:18px;align-items:flex-start;
  padding:16px 0;
  border-bottom:1px solid rgba(255,255,255,0.055);
  transition:background 0.2s;
}
.cred-row:last-child{border-bottom:none;padding-bottom:0;}
.cred-row:first-of-type{padding-top:0;}

.cred-num{
  font-family:'Cormorant Garamond',serif;
  font-size:22px;
  font-weight:300;
  color:rgba(184,136,42,0.35);
  flex-shrink:0;
  width:28px;
  line-height:1;
  margin-top:2px;
}
.cred-title{
  font-family:'Jost',sans-serif;
  font-size:14.5px;
  font-weight:500;
  color:var(--ivory);
  margin-bottom:3px;
  line-height:1.35;
}
.cred-sub{
  font-family:'Josefin Sans',sans-serif;
  font-size:10px;
  letter-spacing:0.1em;
  color:rgba(248,244,237,0.35);
}

/* ── SECTIONS ── */
section{padding:110px 60px;}

.sec-wrap{max-width:1160px;margin:0 auto;}

.sec-eyebrow{
  font-family:'Josefin Sans',sans-serif;
  font-size:10px;
  letter-spacing:0.35em;
  text-transform:uppercase;
  color:var(--gold);
  margin-bottom:10px;
  display:flex;align-items:center;gap:12px;
}
.sec-eyebrow::before{content:'';width:24px;height:1px;background:var(--gold);}

.sec-title{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(34px,4vw,54px);
  font-weight:400;
  color:var(--text);
  line-height:1.15;
  letter-spacing:-0.02em;
  margin-bottom:18px;
}
.sec-title em{font-style:italic;color:var(--gold);}

.sec-lead{
  font-size:17px;
  color:var(--text2);
  line-height:1.85;
  max-width:620px;
}

/* ── ABOUT ── */
.about-sec{background:var(--dark);}
.about-sec .sec-eyebrow,.about-sec .sec-title,.about-sec .sec-lead{color:inherit;}
.about-sec .sec-title{color:var(--ivory);}
.about-sec .sec-title em{color:var(--gold3);}
.about-sec .sec-eyebrow{color:var(--gold2);}
.about-sec .sec-eyebrow::before{background:var(--gold2);}
.about-sec .sec-lead{color:rgba(248,244,237,0.55);}

.about-grid{
  display:grid;
  grid-template-columns:1.1fr 0.9fr;
  gap:80px;
  margin-top:60px;
  align-items:start;
}

.about-body{
  font-size:17px;
  color:rgba(248,244,237,0.62);
  line-height:1.9;
  margin-bottom:22px;
}
.about-body strong{color:rgba(248,244,237,0.9);font-weight:500;}

.exp-stack{display:flex;flex-direction:column;gap:2px;}
.exp-item{
  display:flex;gap:18px;align-items:flex-start;
  padding:18px 20px;
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,255,255,0.04);
  border-left:2px solid rgba(184,136,42,0.3);
  transition:all 0.2s;
  cursor:default;
}
.exp-item:hover{
  background:rgba(184,136,42,0.06);
  border-left-color:var(--gold2);
}
.exp-num{
  font-family:'Cormorant Garamond',serif;
  font-size:28px;font-weight:300;
  color:rgba(184,136,42,0.2);
  flex-shrink:0;width:32px;line-height:1;
  margin-top:2px;
}
.exp-title{
  font-family:'Jost',sans-serif;
  font-size:14.5px;font-weight:500;
  color:var(--ivory);margin-bottom:4px;
}
.exp-desc{
  font-size:13px;
  color:rgba(248,244,237,0.42);
  line-height:1.6;
}

/* ── CSSG ── */
.cssg-sec{background:var(--ivory);}

.cssg-card{
  margin-top:60px;
  display:grid;
  grid-template-columns:0.9fr 1.1fr;
  overflow:hidden;
  border:1px solid var(--ivory3);
}

.cssg-left{
  background:var(--dark);
  padding:56px 52px;
  position:relative;
  overflow:hidden;
}
.cssg-left::before{
  content:'';position:absolute;
  top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--gold),var(--gold2),transparent);
}
.cssg-left::after{
  content:'CSSG';
  position:absolute;bottom:-30px;right:-20px;
  font-family:'Cormorant Garamond',serif;
  font-size:120px;font-weight:700;
  color:rgba(255,255,255,0.025);
  letter-spacing:-0.04em;
  pointer-events:none;user-select:none;
}

.cssg-badge{
  font-family:'Josefin Sans',sans-serif;
  font-size:9px;letter-spacing:0.35em;
  text-transform:uppercase;
  color:var(--gold2);margin-bottom:20px;
}

.cssg-name{
  font-family:'Cormorant Garamond',serif;
  font-size:38px;font-weight:400;
  color:var(--ivory);line-height:1.1;
  margin-bottom:6px;
}

.cssg-full{
  font-family:'Josefin Sans',sans-serif;
  font-size:10px;letter-spacing:0.1em;
  color:rgba(248,244,237,0.32);
  margin-bottom:28px;
}

.cssg-tagline{
  font-family:'Cormorant Garamond',serif;
  font-size:17px;font-style:italic;
  color:rgba(248,244,237,0.55);
  line-height:1.6;margin-bottom:32px;
}

.cssg-verts{display:flex;flex-direction:column;gap:10px;}
.cssg-vert{
  display:flex;align-items:center;gap:12px;
  font-family:'Josefin Sans',sans-serif;
  font-size:10.5px;letter-spacing:0.15em;
  text-transform:uppercase;
  color:rgba(248,244,237,0.45);
}
.cssg-vert::before{content:'';width:20px;height:1px;background:var(--gold2);flex-shrink:0;}

.cssg-right{
  background:var(--white);
  padding:56px 52px;
}
.cssg-right{background:#faf8f3;}

.cssg-role{
  font-family:'Cormorant Garamond',serif;
  font-size:28px;font-weight:400;
  color:var(--text);
  line-height:1.3;margin-bottom:20px;
}

.cssg-body{
  font-size:16px;color:var(--text2);
  line-height:1.88;margin-bottom:28px;
}

.svc-tags{display:flex;flex-wrap:wrap;gap:7px;}
.svc-tag{
  font-family:'Josefin Sans',sans-serif;
  font-size:9.5px;letter-spacing:0.12em;
  text-transform:uppercase;
  padding:7px 14px;
  background:rgba(184,136,42,0.08);
  color:var(--gold);
  border:1px solid rgba(184,136,42,0.2);
}

/* ── FRAULEX ── */
.fraulex-sec{
  background:var(--black);
  padding:110px 60px;
  position:relative;overflow:hidden;
}
.fraulex-sec::before{
  content:'';position:absolute;
  top:-200px;right:-200px;
  width:800px;height:800px;
  background:radial-gradient(circle,rgba(184,136,42,0.05) 0%,transparent 60%);
  pointer-events:none;
}
.fraulex-sec::after{
  content:'';position:absolute;
  bottom:-100px;left:100px;
  width:500px;height:500px;
  background:radial-gradient(circle,rgba(212,168,64,0.04) 0%,transparent 60%);
  pointer-events:none;
}

.fl-inner{max-width:1160px;margin:0 auto;position:relative;z-index:1;}

.fl-head{
  display:grid;grid-template-columns:1fr 1fr;
  gap:80px;align-items:start;
  margin-bottom:64px;
}

.fl-brand{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(52px,6vw,80px);
  font-weight:300;
  color:var(--ivory);
  line-height:0.98;
  letter-spacing:-0.02em;
  margin-bottom:20px;
}
.fl-brand em{font-style:normal;color:var(--gold3);}

.fl-sub{
  font-family:'Josefin Sans',sans-serif;
  font-size:11px;letter-spacing:0.3em;
  text-transform:uppercase;
  color:var(--gold2);
  margin-bottom:22px;
}

.fl-desc{
  font-size:16.5px;
  color:rgba(248,244,237,0.52);
  line-height:1.9;
}

/* Framework */
.fl-framework{
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(184,136,42,0.15);
  padding:38px;
  position:relative;
}
.fl-framework::before{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,var(--gold),var(--gold2));
}

.fl-fw-label{
  font-family:'Josefin Sans',sans-serif;
  font-size:9px;letter-spacing:0.35em;
  text-transform:uppercase;color:var(--gold2);
  margin-bottom:26px;
}

.fl-step{
  display:flex;gap:20px;align-items:flex-start;
  padding:18px 0;
  border-bottom:1px solid rgba(255,255,255,0.05);
}
.fl-step:last-child{border-bottom:none;padding-bottom:0;}

.fl-step-n{
  font-family:'Cormorant Garamond',serif;
  font-size:36px;font-weight:300;
  color:rgba(184,136,42,0.2);
  line-height:1;flex-shrink:0;width:40px;
}
.fl-step-title{
  font-family:'Cormorant Garamond',serif;
  font-size:22px;font-weight:500;
  color:var(--ivory);margin-bottom:6px;
}
.fl-step-desc{
  font-size:13.5px;
  color:rgba(248,244,237,0.4);
  line-height:1.65;
}

/* Products */
.fl-products-label{
  font-family:'Josefin Sans',sans-serif;
  font-size:10px;letter-spacing:0.32em;
  text-transform:uppercase;color:var(--gold2);
  margin-bottom:22px;
  display:flex;align-items:center;gap:12px;
}
.fl-products-label::before{content:'';width:20px;height:1px;background:var(--gold2);}

.prod-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:2px;
}

.prod-card{
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,255,255,0.05);
  padding:32px 28px;
  display:flex;flex-direction:column;gap:14px;
  transition:all 0.25s;
  position:relative;overflow:hidden;
}
.prod-card::after{
  content:'';position:absolute;
  bottom:0;right:0;
  width:60px;height:60px;
  background:radial-gradient(circle,rgba(184,136,42,0.1) 0%,transparent 70%);
  opacity:0;transition:opacity 0.3s;
}
.prod-card:hover{background:rgba(184,136,42,0.05);border-color:rgba(184,136,42,0.2);}
.prod-card:hover::after{opacity:1;}

.prod-accent{
  width:28px;height:2px;
  background:linear-gradient(90deg,var(--gold),var(--gold2));
  margin-bottom:2px;
}

.prod-type{
  font-family:'Josefin Sans',sans-serif;
  font-size:9px;letter-spacing:0.22em;
  text-transform:uppercase;color:var(--gold2);
}

.prod-name{
  font-family:'Cormorant Garamond',serif;
  font-size:20px;font-weight:500;
  color:var(--ivory);line-height:1.25;
}

.prod-desc{
  font-size:13px;
  color:rgba(248,244,237,0.38);
  line-height:1.68;flex:1;
}

/* ── RESEARCH ── */
.research-sec{background:var(--ivory2);}

.research-grid{
  display:grid;grid-template-columns:1fr 1fr;
  gap:70px;margin-top:60px;align-items:start;
}

.res-body{
  font-size:17px;color:var(--text2);
  line-height:1.9;margin-bottom:20px;
}
.res-body strong{color:var(--text);font-weight:500;}

.focus-list{display:flex;flex-direction:column;gap:2px;}
.focus-item{
  background:var(--ivory);
  border:1px solid var(--rule);
  border-left:3px solid var(--gold);
  padding:20px 22px;
  transition:all 0.22s;
}
.focus-item:hover{
  background:var(--white);
  box-shadow:0 8px 32px rgba(26,32,29,0.06);
  border-left-color:var(--gold2);
}
.focus-title{
  font-family:'Jost',sans-serif;
  font-size:15px;font-weight:500;
  color:var(--text);margin-bottom:5px;
}
.focus-desc{
  font-size:13.5px;color:var(--text3);
  line-height:1.6;
}

/* ── CONTACT ── */
.contact-sec{
  background:var(--dark);
  padding:110px 60px;
  text-align:center;
  position:relative;overflow:hidden;
}
.contact-sec::before{
  content:'';position:absolute;
  top:0;left:50%;transform:translateX(-50%);
  width:600px;height:1px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent);
}
.contact-sec::after{
  content:'';position:absolute;
  top:50%;left:50%;transform:translate(-50%,-50%);
  width:700px;height:700px;
  background:radial-gradient(circle,rgba(184,136,42,0.05) 0%,transparent 65%);
  pointer-events:none;
}

.contact-eyebrow{
  font-family:'Josefin Sans',sans-serif;
  font-size:10px;letter-spacing:0.35em;
  text-transform:uppercase;color:var(--gold2);
  margin-bottom:20px;
}

.contact-title{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(38px,5vw,68px);
  font-weight:300;color:var(--ivory);
  line-height:1.1;margin-bottom:16px;
  position:relative;z-index:1;
}
